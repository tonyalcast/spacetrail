{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "spacetrail",
  "version": "0.1.0",
  "identifier": "io.github.tonyalcast.spacetrail",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "spacetrail",
        "width": 1200,
        "height": 860,
        "minWidth": 900,
        "minHeight": 620,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "public.app-category.utilities",
    "shortDescription": "See what fills your disk and what you can safely free",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "spacetrail-dev",
      "hardenedRuntime": true
    }
  }
}
